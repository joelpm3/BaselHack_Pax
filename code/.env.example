# Copy to .env.local and fill in. Never commit .env.local.

# LLM: "anthropic" now; "openai-compatible" for a self-hosted vLLM endpoint (Nebius).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# fast (default) or standard; fast mode works only on Opus 5.5 / 5 / 4.8 and is ignored elsewhere
ANTHROPIC_SPEED=fast
# used instead while fast mode is rate limited or overloaded
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_API_KEY=
# LLM_MODEL=
# Optional per-role overrides: LLM_MODEL_CHAT, LLM_MODEL_ANALYSIS, LLM_MODEL_EXTRACTION, LLM_MODEL_SIMULATION

# Logismata APICalc (token from the hackathon hub Tools page)
LOGISMATA_API_BASE=https://baselhackathon2026.azurewebsites.net/viper
LOGISMATA_API_TOKEN=

# Pax Quicksale demo (live premiums)
QUICKSALE_BASE_URL=https://portal.pax.ch/quicksale/edu

# Swiss-German Nemotron STT (swiss-german-stt/cookbook/nebius-nemotron, via SSH tunnel)
STT_BASE_URL=http://127.0.0.1:8000

# Company dashboard password and secrets (generate with: openssl rand -hex 32)
COMPANY_PASSWORD=pax-demo
SESSION_SECRET=
DOCUMENT_ENCRYPTION_KEY=

DATA_DIR=./data
